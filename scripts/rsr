#!/usr/bin/env bash
# 明确选择解释器；默认使用本项目 uv 环境，Isaac 路径需显式提供。
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export RSR_ASSETS_ROOT="${RSR_ASSETS_ROOT:-$ROOT/assets}"
if [[ -n "${RSR_ISAACSIM_HOME:-}" ]]; then
  PYTHON_SH="$RSR_ISAACSIM_HOME/python.sh"
  if [[ ! -x "$PYTHON_SH" ]]; then
    echo "找不到可执行的 Isaac python.sh: $PYTHON_SH" >&2
    exit 1
  fi
  exec "$PYTHON_SH" -m real2sim2real.core.cli "$@"
fi
exec uv run --project "$ROOT" --locked rsr "$@"
